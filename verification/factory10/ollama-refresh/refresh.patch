+// gpuRefreshTimeout applies only after initial device discovery.
+func gpuRefreshTimeout() time.Duration {
+	const fallback = 15 * time.Second
+	raw := os.Getenv("OLLAMA_GPU_REFRESH_TIMEOUT")
+	if raw == "" {
+		return fallback
+	}
+	timeout, err := time.ParseDuration(raw)
+	if err != nil || timeout <= 0 {
+		slog.Warn("invalid OLLAMA_GPU_REFRESH_TIMEOUT; using 15s", "value", raw)
+		return fallback
+	}
+	return timeout
+}
 
