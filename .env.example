# Generate a random 32+ character controller token. Use the same token on PC B.
FACTORY_TOKEN=
# PC A: docker compose --profile controller up -d --build
# PC B: docker compose --profile worker up -d --build
CONTROLLER_URL=http://100.x.y.z:8000
WORKER_ID=worker-b
# Default controller API stays on loopback. Set ONLY a private/Tailscale host IP
# to let PC B connect; protect port 8000 with the host firewall.
API_BIND=127.0.0.1
# Set a specific private/Tailscale IP for a shared controller dashboard.
WEB_BIND=127.0.0.1
SECRETS_DIR=./secrets
DRIVE_TOKEN_FILE=/run/secrets/drive-token.json
DRIVE_PARENT_ID=
YOUTUBE_TOKEN_DIR=/run/secrets/youtube
SCRATCH_GB=8
FREE_RESERVE_GB=4
# Remote approved-asset cache; also counts toward the worker scratch budget.
ASSET_CACHE_BYTES=2147483648
CONTROLLER_SCRATCH_DIR=./scratch/controller
WORKER_SCRATCH_DIR=./scratch/worker
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
FFMPEG_ENCODER=x264
# Optional CPU narration. Rebuild after changing; download weights in Settings.
WITH_TTS=0
# Default CPU. GPU overlay selects bounded offload using measured free VRAM.
OLLAMA_GPU_LAYERS=0
